# Copy to .env and fill in. Never commit .env.

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu) - free account.
# S3 access keys are generated in the CDSE S3 credentials page. [VERIFY current process]
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# Descriptive User-Agent required by Nominatim's usage policy (include a contact).
NOMINATIM_USER_AGENT=SatEnhance/0.1 (you@example.com)

# Hard cap on AOI area in km2.
SATENHANCE_MAX_AREA_KM2=100

# Set to 1 to run the enhancer with networking disabled (models must be prefetched).
SATENHANCE_OFFLINE=0
