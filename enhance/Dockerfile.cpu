# System 2, CPU (SEN2SR "lite" model). Build from the repo root:
#   docker build -f enhance/Dockerfile.cpu .
# Override for networks that cannot reach the Debian mirrors, e.g. --build-arg BASE_IMAGE=python:3.11
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

# CPU-only PyTorch wheels. Override, e.g. --build-arg TORCH_INDEX_URL=https://pypi.org/simple
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# torchvision is required by timm (a SEN2SR dependency). Install it from the SAME index as torch so
# pip never needs to replace torch to satisfy a mismatched torchvision from PyPI.
ARG TORCH_SPEC="torch torchvision"

ENV PIP_CACHE_DIR=/root/.cache/pip PIP_DEFAULT_TIMEOUT=300 PIP_RETRIES=10 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1 HOME=/tmp \
    HF_HOME=/data/cache/hf SATENHANCE_IMAGE_FLAVOR=cpu

# rasterio wheels need libexpat at runtime (not present in python:*-slim)
RUN ldconfig -p | grep -q libexpat.so.1 || \
    (apt-get update && apt-get install -y --no-install-recommends libexpat1 \
     && rm -rf /var/lib/apt/lists/*)

COPY docker/pip_retry.sh /usr/local/bin/pip-retry

RUN --mount=type=secret,id=cabundle,target=/tmp/ca.pem,required=false \
    --mount=type=cache,target=/root/.cache/pip \
    if [ -s /tmp/ca.pem ]; then export PIP_CERT=/tmp/ca.pem; fi; \
    pip-retry --index-url ${TORCH_INDEX_URL} ${TORCH_SPEC} \
    && pip freeze | grep -iE '^(torch|torchvision|triton)==' > /opt/torch-constraints.txt \
    && cat /opt/torch-constraints.txt

WORKDIR /src
COPY enhance/requirements.lock /tmp/requirements.lock
RUN --mount=type=secret,id=cabundle,target=/tmp/ca.pem,required=false \
    --mount=type=cache,target=/root/.cache/pip \
    if [ -s /tmp/ca.pem ]; then export PIP_CERT=/tmp/ca.pem; fi; \
    pip-retry -c /opt/torch-constraints.txt -r /tmp/requirements.lock

COPY common ./common
COPY enhance ./enhance
RUN --mount=type=secret,id=cabundle,target=/tmp/ca.pem,required=false \
    --mount=type=cache,target=/root/.cache/pip \
    if [ -s /tmp/ca.pem ]; then export PIP_CERT=/tmp/ca.pem; fi; \
    pip-retry --no-deps ./common ./enhance

RUN useradd -m -u 1000 app && mkdir -p /data/rawdata /data/output /data/cache && chown -R app /data
USER app
WORKDIR /data
ENTRYPOINT ["satenhance-enhance"]
CMD ["--help"]
