# System 2, GPU (SEN2SR "lite" + full Mamba model). Needs the NVIDIA Container Toolkit.
# Build from the repo root:  docker build -f enhance/Dockerfile.gpu .
#
# mamba-ssm compiles CUDA kernels and the SEN2SR README warns the build is slow and fragile.
# The versions below are a best guess and are UNTESTED here (no GPU / no access to the PyTorch
# index from the authoring sandbox) [VERIFY]. If the build fails, pin a torch / CUDA / mamba-ssm
# combination known to work for your GPU via the build args.
ARG CUDA_VERSION=12.4.1

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu22.04 AS builder
ARG CUDA_VERSION
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG TORCH_SPEC="torch torchvision"
# mamba-ssm 2.3.x requires triton>=3.5 (plus tilelang, quack-kernels ...), which makes pip replace the
# CUDA 12.4 torch with a CUDA 13 build (seen in a real build log). Stay on the 2.2 series unless you
# also move torch/CUDA. [VERIFY that 2.2.x is compatible with SEN2SR's full model]
ARG MAMBA_SPEC="mamba-ssm<2.3"
# Compiling mamba-ssm's CUDA kernels can exhaust RAM with too many parallel jobs.
ARG MAX_JOBS=4
# Extra packages the model loader may need (e.g. "causal-conv1d"; unknown until the weights are
# downloaded, see `selftest`). Installed under the same torch constraints.
ARG EXTRA_PIP_PACKAGES=""
ARG TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0"
ENV DEBIAN_FRONTEND=noninteractive PIP_CACHE_DIR=/root/.cache/pip PIP_DEFAULT_TIMEOUT=300 PIP_RETRIES=10 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} MAX_JOBS=${MAX_JOBS}
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-dev build-essential ninja-build git \
    && rm -rf /var/lib/apt/lists/*
RUN python3.11 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY docker/pip_retry.sh /usr/local/bin/pip-retry
RUN --mount=type=secret,id=cabundle,target=/tmp/ca.pem,required=false \
    --mount=type=cache,target=/root/.cache/pip \
    if [ -s /tmp/ca.pem ]; then export PIP_CERT=/tmp/ca.pem; fi; \
    pip-retry --index-url ${TORCH_INDEX_URL} ${TORCH_SPEC} && pip-retry wheel packaging setuptools \
    && pip freeze | grep -iE '^(torch|torchvision|triton)==' > /opt/torch-constraints.txt \
    && cat /opt/torch-constraints.txt
# mamba-ssm must be built against the installed torch
RUN --mount=type=secret,id=cabundle,target=/tmp/ca.pem,required=false \
    --mount=type=cache,target=/root/.cache/pip \
    if [ -s /tmp/ca.pem ]; then export PIP_CERT=/tmp/ca.pem; fi; \
    pip-retry -c /opt/torch-constraints.txt --no-build-isolation ${MAMBA_SPEC} \
    && if [ -n "${EXTRA_PIP_PACKAGES}" ]; then pip-retry -c /opt/torch-constraints.txt --no-build-isolation ${EXTRA_PIP_PACKAGES}; fi
WORKDIR /src
COPY enhance/requirements.lock /tmp/requirements.lock
RUN --mount=type=secret,id=cabundle,target=/tmp/ca.pem,required=false \
    --mount=type=cache,target=/root/.cache/pip \
    if [ -s /tmp/ca.pem ]; then export PIP_CERT=/tmp/ca.pem; fi; \
    pip-retry -c /opt/torch-constraints.txt -r /tmp/requirements.lock
COPY common ./common
COPY enhance ./enhance
RUN --mount=type=secret,id=cabundle,target=/tmp/ca.pem,required=false \
    --mount=type=cache,target=/root/.cache/pip \
    if [ -s /tmp/ca.pem ]; then export PIP_CERT=/tmp/ca.pem; fi; \
    pip-retry --no-deps ./common ./enhance

# Fail the build (not the first run) if pip swapped torch for a build with a different CUDA.
RUN python -c "import os,sys,torch; v=torch.version.cuda or ''; want=os.environ['CUDA_VERSION'].rsplit('.',1)[0]; print('torch', torch.__version__, 'cuda', v); sys.exit(0 if v.startswith(want) else 'CUDA mismatch: torch has %s, base image has %s' % (v, want))"

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HOME=/tmp HF_HOME=/data/cache/hf \
    SATENHANCE_IMAGE_FLAVOR=gpu MPLBACKEND=Agg MPLCONFIGDIR=/tmp/matplotlib \
    PATH=/opt/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 libexpat1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
RUN useradd -m -u 1000 app && mkdir -p /data/rawdata /data/output /data/cache && chown -R app /data
USER app
WORKDIR /data
ENTRYPOINT ["satenhance-enhance"]
CMD ["--help"]
